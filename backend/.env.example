# ==========================================
# Configuration Huwise OAuth
# ==========================================
HUWISE_CLIENT_ID=your_client_id_here
HUWISE_CLIENT_SECRET=your_client_secret_here
HUWISE_AUTH_URL=https://data.bretagne.bzh/oauth2/authorize
HUWISE_TOKEN_URL=https://data.bretagne.bzh/oauth2/token

# ==========================================
# Callback URL
# IMPORTANT: Doit correspondre EXACTEMENT à celle enregistrée dans Huwise
# Production: https://recette-canaux-bretagne.cleverapps.io/api/auth/callback
# Local: http://localhost:3000/api/auth/callback (doit aussi être enregistrée)
# ==========================================
CALLBACK_URL=https://recette-canaux-bretagne.cleverapps.io/api/auth/callback

# ==========================================
# URLs internes
# ==========================================
# CLIENT_URL est utilisée pour:
# - Redirection après authentification
# - Configuration CORS
CLIENT_URL=https://recette-canaux-bretagne.cleverapps.io

# ==========================================
# Configuration serveur
# ==========================================
PORT=3000
NODE_ENV=production

# Note: En développement local, utiliser .env.local avec:
# CALLBACK_URL=http://localhost:3000/api/auth/callback
# CLIENT_URL=http://localhost:3000
# NODE_ENV=development

