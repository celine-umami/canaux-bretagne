# Configuration Apache 2.4 pour Clever Cloud

# Activer le module rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Servir les fichiers et dossiers existants comme-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Réécrire /api/auth/login vers /api/auth/login.php (sans extension visuelle)
    RewriteRule ^api/auth/login$ api/auth/login.php [QSA,L]
    
    # Réécrire /api/auth/callback vers /api/auth/callback.php (sans extension visuelle)
    RewriteRule ^api/auth/callback$ api/auth/callback.php [QSA,L]
    
    # Réécrire /api/token vers /api/token.php (sans extension visuelle)
    RewriteRule ^api/token$ api/token.php [QSA,L]
    
    # Rediriger vers index.html pour les autres requêtes (SPA)
    RewriteRule ^(?!api/).*$ index.html [QSA,L]
</IfModule>

# Support pour les fichiers PHP
<IfModule mod_addtype.c>
    AddType application/x-httpd-php .php
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
